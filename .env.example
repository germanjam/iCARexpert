# iCARexpert Environment Configuration

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///./icarexpert.db
SQLALCHEMY_ECHO=False

# ============================================
# LLM (Ollama - Local Llama 2)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:7b-chat-q4_K_M
OLLAMA_TIMEOUT=300
OLLAMA_NUM_GPU=1

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=icarexpert@example.com
SMTP_FROM_NAME=iCARexpert AI

# ============================================
# SCRAPING CONFIGURATION
# ============================================
SCRAPER_ENABLED=True
SCRAPER_DELAY=2
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ============================================
# APPLICATION
# ============================================
APP_NAME=iCARexpert
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/icarexpert.log
